// Speed-Tac Bay 02 Interactive World — 5 Custom World-Space 3D Animated Handshakes + Spark VFX
// Exact YXZ 2-link analytical arm IK in Three.js + 3D Lightning Bolts + Golden Dap Fireworks + Live Counter!

import * as THREE from '../vendor/three.module.js';
import {
  resetBodyPose,
  setFingerCurl,
  setFingerCascade,
  setMetacarpalArch,
  setEyesAndBrows,
  solveArmIKWorld,
  applyAnticipationWeightShift,
} from './characters.js';

export { solveArmIKWorld };

export const HANDSHAKE_TYPES = [
  {
    id: 1,
    key: '1',
    name: 'Executive Trap + Electric Zap!',
    shortName: '1. Electric Zap',
    duration: 2.35,
    desc: 'Classic 3-pump clasp that erupts into Foreman’s 10,000V shop-glove spark burst!',
  },
  {
    id: 2,
    key: '2',
    name: 'PJ-WA-WA 7-Step Bro-Dap!',
    shortName: '2. PJ 7-Step Dap',
    duration: 2.60,
    desc: 'High palm slap -> slide -> thumb-hook -> knuckle bump -> snap -> chest tap -> BOOM firework!',
  },
  {
    id: 3,
    key: '3',
    name: 'Fake-Out Hardhat Psych!',
    shortName: '3. Hardhat Psych',
    duration: 2.20,
    desc: 'Reaches in eagerly, then yanks hand straight up to adjust hardhat brim while victim hangs!',
  },
  {
    id: 4,
    key: '4',
    name: "Carl's Paper-Covers-Rock Fail!",
    shortName: '4. Carl Fist-Fail',
    duration: 2.25,
    desc: 'Partner offers open flat palm; initiator panics and jams a clenched rock fist into it!',
  },
  {
    id: 5,
    key: '5',
    name: 'Tiny Giant-Fingertip Shake!',
    shortName: '5. Tiny Pinch',
    duration: 2.20,
    desc: 'Delicate two-millimeter thumb-and-index fingertip pinch shake—zero crushed wrenches!',
  },
];

const BANTER_BY_TYPE = {
  1: [
    ['Put it there! Firm Paulden grip!', 'Whoa—WAIT—BZZZT-YOWWW!!'],
    ['Standard Executive Protocol!', 'Is that 10,000 volts in your glove?!'],
  ],
  2: [
    ['Slap—slide—hook—bump—snap—BOOM!', 'Zero friction! 7-step Kinesiology perfection!'],
    ['Patrick "PJ-WA-WA" Wounded Arrow Redbird dap!', 'Scapular stabilizers engaged—metacarpal arch locked!'],
  ],
  3: [
    ['Up top, pal—PSYCH! Checking the hardhat!', '...Left hanging on the Bay 02 floor. This saddens me.'],
    ['Put it there—nope, chinstrap check!', 'Dot never warned me about Fake-Out #3!'],
  ],
  4: [
    ['I panicked and threw Rock into Open Palm!', '...Did you just fist-bump my open palm, Carl?'],
    ['Paper covers rock! Nailed it, right?!', 'What is done under compulsion is done blindly, Carl.'],
  ],
  5: [
    ['Ultra-delicate two-fingertip pinch. Very gentle!', 'So polite! Zero crushed metacarpals!'],
    ['Dainty precision shake—0.002" tolerance!', 'Exquisite Paulden manners!'],
  ],
};

// Damped spring overshoot + recoil curve (`+3mm` impact compression -> `6mm` rebound settle)
function impactOvershootRecoil(dtAfterHit) {
  if (dtAfterHit <= 0) return 0;
  return -0.0032 * Math.exp(-28 * dtAfterHit) + 0.0065 * Math.exp(-11 * dtAfterHit) * Math.sin(32 * dtAfterHit);
}

export class HandshakeManager {
  constructor(scene, onCountChanged = null, onTrauma = null) {
    this.scene = scene;
    this.onCountChanged = onCountChanged;
    this.onTrauma = onTrauma;
    this.handshakesToday = 1402;
    this.workDoneToday = 0;
    this.activeSessions = [];
    this.particles = [];
    this.bolts = [];

    this._buildVfxPool();
  }

  _buildVfxPool() {
    const sparkGeo = new THREE.BoxGeometry(0.018, 0.018, 0.052);
    this.matCyanSpark = new THREE.MeshBasicMaterial({ color: 0x5eead4 });
    this.matGoldSpark = new THREE.MeshBasicMaterial({ color: 0xfbbf24 });

    // 4 jagged 3D electric arc bolts + flash light
    for (let i = 0; i < 4; i++) {
      const grp = new THREE.Group();
      const segGeo = new THREE.CylinderGeometry(0.008, 0.014, 0.14, 6);
      for (let s = 0; s < 3; s++) {
        const seg = new THREE.Mesh(segGeo, i % 2 === 0 ? this.matCyanSpark : this.matGoldSpark);
        seg.position.set((s - 1) * 0.05, s * 0.09, (s % 2 ? 1 : -1) * 0.03);
        seg.rotation.set(0.4 * (s + 1), 0.3 * i, 0.5 * (s % 2 ? 1 : -1));
        grp.add(seg);
      }
      grp.visible = false;
      this.scene.add(grp);
      this.bolts.push(grp);
    }

    this.sparkLight = new THREE.PointLight(0x38bdf8, 0, 5.5);
    this.scene.add(this.sparkLight);
    this._sparkGeo = sparkGeo;
  }

  _spawnSparkBurst(origin, count = 20, goldenOnly = false) {
    for (let i = 0; i < count; i++) {
      const mat = goldenOnly || i % 2 === 0 ? this.matGoldSpark : this.matCyanSpark;
      const m = new THREE.Mesh(this._sparkGeo, mat);
      m.position.copy(origin);
      const az = (i / count) * Math.PI * 2 + Math.random() * 0.35;
      const el = 0.25 + Math.random() * 0.85;
      const spd = 1.4 + Math.random() * 1.8;
      const vx = Math.cos(az) * Math.cos(el) * spd;
      const vy = Math.sin(el) * spd + 0.6;
      const vz = Math.sin(az) * Math.cos(el) * spd;
      m.lookAt(origin.x + vx, origin.y + vy, origin.z + vz);
      this.scene.add(m);
      this.particles.push({ mesh: m, vx, vy, vz, life: 0.68, maxLife: 0.68 });
    }
  }

  startHandshake(charA, charB, typeId = 1, audioEngine = null, castMgr = null) {
    if (!charA || !charB || charA === charB) return false;
    if (charA.activeHandshake || charB.activeHandshake) return false;

    const hMeta = HANDSHAKE_TYPES.find((h) => h.id === typeId) || HANDSHAKE_TYPES[0];

    // Face each other cleanly and ensure comfortable reach spacing (~0.52m..0.72m)
    const pa = charA.anchor.position;
    const pb = charB.anchor.position;
    let dx = pb.x - pa.x;
    let dz = pb.z - pa.z;
    let dist = Math.hypot(dx, dz);
    if (dist < 0.05) {
      dx = 0; dz = 0.55; dist = 0.55;
    }
    const idealDist = 0.32 * (charA.J._scale + charB.J._scale);
    if (dist > idealDist * 1.35 || dist < idealDist * 0.72) {
      const midX = (pa.x + pb.x) * 0.5;
      const midZ = (pa.z + pb.z) * 0.5;
      const nx = dx / dist;
      const nz = dz / dist;
      pa.x = midX - nx * idealDist * 0.5;
      pa.z = midZ - nz * idealDist * 0.5;
      pb.x = midX + nx * idealDist * 0.5;
      pb.z = midZ + nz * idealDist * 0.5;
    }

    charA.anchor.rotation.y = Math.atan2(pb.x - pa.x, pb.z - pa.z);
    charB.anchor.rotation.y = Math.atan2(pa.x - pb.x, pa.z - pb.z);
    charA.dispatchTarget = null;
    charB.dispatchTarget = null;

    const mid = new THREE.Vector3(
      (pa.x + pb.x) * 0.5,
      0.34 * Math.min(1.35, (charA.J._scale + charB.J._scale) * 0.5),
      (pa.z + pb.z) * 0.5
    );

    const session = {
      charA,
      charB,
      typeId: hMeta.id,
      duration: hMeta.duration,
      elapsed: 0,
      mid,
      burstTriggered: false,
    };
    charA.activeHandshake = session;
    charB.activeHandshake = session;
    this.activeSessions.push(session);

    // Increment Bay 02 live handshake counter (WORK DONE remains 0!)
    this.handshakesToday += 1;
    if (this.onCountChanged) {
      this.onCountChanged(this.handshakesToday, this.workDoneToday, hMeta, charA, charB);
    }

    // Trigger GTA banter bubbles
    const linesList = BANTER_BY_TYPE[hMeta.id] || BANTER_BY_TYPE[1];
    const [lineA, lineB] = linesList[this.handshakesToday % linesList.length];
    if (castMgr) {
      castMgr.triggerSpeech(charA, lineA, 3.8);
      castMgr.triggerSpeech(charB, lineB, 4.0);
    } else {
      charA.speechText = lineA; charA.speechTimer = 3.8;
      charB.speechText = lineB; charB.speechTimer = 4.0;
    }

    if (audioEngine) {
      audioEngine.playHandshakeCue(hMeta.id, mid);
    }
    return true;
  }

  update(dt, elapsed) {
    // Update flying spark particles
    for (let i = this.particles.length - 1; i >= 0; i--) {
      const p = this.particles[i];
      p.life -= dt;
      if (p.life <= 0) {
        this.scene.remove(p.mesh);
        this.particles.splice(i, 1);
        continue;
      }
      p.vy -= 5.4 * dt;
      p.mesh.position.x += p.vx * dt;
      p.mesh.position.y = Math.max(0.02, p.mesh.position.y + p.vy * dt);
      p.mesh.position.z += p.vz * dt;
      const sc = Math.max(0.15, p.life / p.maxLife);
      p.mesh.scale.set(sc, sc, sc * 1.3);
    }

    let anyBoltActive = false;

    for (let i = this.activeSessions.length - 1; i >= 0; i--) {
      const s = this.activeSessions[i];
      s.elapsed += dt;
      const u = Math.min(1, s.elapsed / s.duration);

      this._poseSession(s, u, elapsed);

      if (s.typeId === 1 && u >= 0.42 && u <= 0.80) {
        anyBoltActive = true;
        this.sparkLight.position.copy(s.mid);
        this.sparkLight.color.setHex(0x38bdf8);
        this.sparkLight.intensity = 3.5 + 2.0 * Math.sin(elapsed * 45);
        this.bolts.forEach((b, bi) => {
          b.visible = true;
          b.position.copy(s.mid);
          b.rotation.set(Math.sin(elapsed * 22 + bi), elapsed * 12 + bi * 1.5, Math.cos(elapsed * 19 + bi));
          const bsc = 0.85 + 0.35 * Math.sin(elapsed * 30 + bi);
          b.scale.setScalar(bsc);
        });
      }

      if (s.elapsed >= s.duration) {
        s.charA.activeHandshake = null;
        s.charB.activeHandshake = null;
        resetBodyPose(s.charA);
        resetBodyPose(s.charB);
        this.activeSessions.splice(i, 1);
      }
    }

    if (!anyBoltActive) {
      this.sparkLight.intensity = Math.max(0, this.sparkLight.intensity - dt * 14);
      this.bolts.forEach((b) => { b.visible = false; });
    }
  }

  _poseSession(s, u, elapsed) {
    const { charA, charB, typeId } = s;
    resetBodyPose(charA);
    resetBodyPose(charB);

    const pa = charA.anchor.position;
    const pb = charB.anchor.position;
    const fwdX = pb.x - pa.x;
    const fwdZ = pb.z - pa.z;
    const fLen = Math.max(0.01, Math.hypot(fwdX, fwdZ));
    const nx = fwdX / fLen;
    const nz = fwdZ / fLen;
    // Perpendicular right normal in XZ
    const rx = -nz;
    const rz = nx;

    const midY = 0.34;
    s.mid.set((pa.x + pb.x) * 0.5, midY, (pa.z + pb.z) * 0.5);

    const tgtA = new THREE.Vector3();
    const tgtB = new THREE.Vector3();

    // Pre-reach Whole-Body Anticipation Weight-Shift across all 5 handshakes (`-22mm` windup -> `+24mm` drive)!
    if (u < 0.14) {
      const windup = Math.sin((u / 0.14) * Math.PI);
      applyAnticipationWeightShift(charA, -0.015 * windup, -0.022 * windup, -0.14 * windup, 0.010 * windup);
      applyAnticipationWeightShift(charB, -0.015 * windup, -0.022 * windup, -0.14 * windup, 0.010 * windup);
    } else if (u < 0.42) {
      const drive = Math.sin(((u - 0.14) / 0.28) * Math.PI * 0.5);
      applyAnticipationWeightShift(charA, 0.006 * drive, 0.024 * drive, 0.08 * drive, 0.008 * drive);
      applyAnticipationWeightShift(charB, 0.006 * drive, 0.024 * drive, 0.08 * drive, 0.008 * drive);
    }

    if (typeId === 1) {
      // 1. EXECUTIVE TRAP PUMP + ELECTRIC SPARK BURST!
      if (u < 0.42) {
        const reach = Math.min(1, u / 0.14);
        const arcDip = -0.036 * Math.sin(reach * Math.PI);
        const recoil = impactOvershootRecoil(u - 0.14);
        const pumpPhase = u > 0.14 ? ((u - 0.14) / 0.28) * Math.PI * 3 : 0;
        const pump = Math.sin(pumpPhase) * 0.046;
        const ulnarWhip = Math.sin(pumpPhase) * 0.34;
        const sep = 0.10 * (1 - reach) + 0.018 + recoil;

        tgtA.set(s.mid.x + rx * sep, midY + arcDip + pump, s.mid.z + rz * sep);
        tgtB.set(s.mid.x - rx * sep, midY + arcDip + pump, s.mid.z - rz * sep);
        solveArmIKWorld(charA, 'R', tgtA, 0.18 * reach, -0.12 * (1 - reach), ulnarWhip);
        solveArmIKWorld(charB, 'R', tgtB, 0.18 * reach, -0.12 * (1 - reach), ulnarWhip);
        setFingerCascade(charA.J, 'R', (u - 0.08) / 0.12, 0.10, 0.90, 0.88);
        setFingerCascade(charB.J, 'R', (u - 0.08) / 0.12, 0.10, 0.90, 0.88);
        setEyesAndBrows(charA.J, 1.0, 0.4);
        setEyesAndBrows(charB.J, 1.1, 0.5);
      } else if (u < 0.82) {
        if (!s.burstTriggered) {
          s.burstTriggered = true;
          this._spawnSparkBurst(s.mid, 24, false);
          if (charA.id === 'carl') charA.smokeTimer = 3.5;
          if (charB.id === 'carl') charB.smokeTimer = 3.5;
          if (this.onTrauma) this.onTrauma(0.92, true);
        }
        const jolt = Math.sin(elapsed * 42);
        applyAnticipationWeightShift(charB, -0.018 * jolt, -0.026, 0.16 * jolt, 0.014);
        charA.J.spine.rotation.set(-0.20 + 0.16 * jolt, 0.14 * jolt, 0);
        charB.J.spine.rotation.set(-0.24 + 0.18 * jolt, -0.16 * jolt, 0);
        charB.J.shoulderL.rotation.set(-1.85, 0, 0.65);
        tgtA.set(s.mid.x + rx * 0.018, midY + 0.03 * jolt, s.mid.z + rz * 0.018);
        tgtB.set(s.mid.x - rx * 0.018, midY + 0.03 * jolt, s.mid.z - rz * 0.018);
        solveArmIKWorld(charA, 'R', tgtA, 0.25 * jolt, 0.18 * jolt, 0.32 * jolt);
        solveArmIKWorld(charB, 'R', tgtB, -0.25 * jolt, -0.18 * jolt, -0.32 * jolt);
        setFingerCascade(charA.J, 'R', 1.0, 0.10, 0.92, 0.92);
        setFingerCascade(charB.J, 'R', 1.0, 0.10, 0.92, 0.92);
        setEyesAndBrows(charA.J, 1.55, -0.8);
        setEyesAndBrows(charB.J, jolt > 0 ? 1.7 : 0.15, 1.0);
      } else {
        applyAnticipationWeightShift(charB, 0, -0.020, 0, 0.018);
        charB.J.spine.rotation.set(0.28, 0, 0.08);
        charB.J.head.rotation.set(0.22, 0, 0.12);
        setEyesAndBrows(charB.J, 0.30, 'sad');
      }
    } else if (typeId === 2) {
      // 2. PATRICK "PJ-WA-WA" WOUNDED ARROW 7-STEP ISU KINESIOLOGY DAP!
      if (u < 0.18) {
        // Step 1 & 2: J-hook parabolic sweep -> High vertical palm slap + overshoot recoil!
        const p = Math.min(1, u / 0.12);
        const arcDip = -0.035 * Math.sin(p * Math.PI);
        const slapRecoil = impactOvershootRecoil(u - 0.12);
        const sep = 0.12 * (1 - p) + 0.017 + slapRecoil;
        tgtA.set(s.mid.x + rx * sep, midY + 0.062 + arcDip, s.mid.z + rz * sep);
        tgtB.set(s.mid.x - rx * sep, midY + 0.062 + arcDip, s.mid.z - rz * sep);
        const wristExt = -0.32 * (1 - p * 0.35);
        solveArmIKWorld(charA, 'R', tgtA, 0.10, wristExt, -0.22 * p);
        solveArmIKWorld(charB, 'R', tgtB, 0.10, wristExt, -0.22 * p);
        setFingerCascade(charA.J, 'R', 0.0, 0.08, 0.85, 0.30);
        setFingerCascade(charB.J, 'R', 0.0, 0.08, 0.85, 0.30);
      } else if (u < 0.34) {
        // Step 3: Staggered thumb-hook clasp + metacarpal palm cup!
        const cu = (u - 0.18) / 0.16;
        const hookRecoil = impactOvershootRecoil(cu * 0.16);
        tgtA.set(s.mid.x + rx * (0.018 + hookRecoil), midY + 0.03, s.mid.z + rz * (0.018 + hookRecoil));
        tgtB.set(s.mid.x - rx * (0.018 + hookRecoil), midY + 0.03, s.mid.z - rz * (0.018 + hookRecoil));
        solveArmIKWorld(charA, 'R', tgtA, 0.58, 0.12, 0.18);
        solveArmIKWorld(charB, 'R', tgtB, 0.58, 0.12, 0.18);
        setFingerCascade(charA.J, 'R', cu * 1.35, 0.08, 0.86, 0.90);
        setFingerCascade(charB.J, 'R', cu * 1.35, 0.08, 0.86, 0.90);
      } else if (u < 0.54) {
        // Step 4: 55% Forearm / 45% Wrist Pronated Knuckle Fist-Bump + +3mm press & recoil!
        const bu = (u - 0.34) / 0.20;
        const reach = Math.min(1, bu / 0.42);
        const arcLift = 0.028 * Math.sin(reach * Math.PI);
        const bumpRecoil = impactOvershootRecoil((bu - 0.42) * 0.20);
        const off = 0.082 * (1 - reach) + 0.021 + bumpRecoil;
        tgtA.set(s.mid.x - nx * off, midY + arcLift, s.mid.z - nz * off);
        tgtB.set(s.mid.x + nx * off, midY + arcLift, s.mid.z + nz * off);
        solveArmIKWorld(charA, 'R', tgtA, 1.56, 0.08, 0.24 * reach);
        solveArmIKWorld(charB, 'R', tgtB, 1.56, 0.08, 0.24 * reach);
        setFingerCascade(charA.J, 'R', bu * 1.6, 0.35, 0.96, 0.96);
        setFingerCascade(charB.J, 'R', bu * 1.6, 0.35, 0.96, 0.96);
        setEyesAndBrows(charA.J, 1.35, 0.85);
        setEyesAndBrows(charB.J, 1.35, 0.85);
      } else if (u < 0.74) {
        // Step 5 & 6: Pull-back Ulnar Wrist Whip Finger-Snap & Scapular Chest Tap!
        const su = (u - 0.54) / 0.20;
        const p = Math.sin(su * Math.PI);
        applyAnticipationWeightShift(charA, -0.012 * p, -0.018 * p, 0.14 * p, 0.006 * p);
        applyAnticipationWeightShift(charB, -0.012 * p, -0.018 * p, 0.14 * p, 0.006 * p);
        tgtA.set(s.mid.x - nx * 0.14 + rx * 0.10, midY + 0.08 * p, s.mid.z - nz * 0.14 + rz * 0.10);
        tgtB.set(s.mid.x + nx * 0.14 - rx * 0.10, midY + 0.08 * p, s.mid.z + nz * 0.14 - rz * 0.10);
        const ulnarSnap = su < 0.45 ? -0.32 : 0.38 * Math.exp(-6 * (su - 0.45));
        solveArmIKWorld(charA, 'R', tgtA, -0.48, -0.14, ulnarSnap);
        solveArmIKWorld(charB, 'R', tgtB, -0.48, -0.14, ulnarSnap);
        setFingerCurl(charA.J, 'R', 0.05, 0.84, 0.95, 0.45, 0.90, 0.82);
        setFingerCurl(charB.J, 'R', 0.05, 0.84, 0.95, 0.45, 0.90, 0.82);
      } else {
        // Step 7: BOOM Firework Flare!
        if (!s.burstTriggered) {
          s.burstTriggered = true;
          const highMid = s.mid.clone();
          highMid.y += 0.18;
          this._spawnSparkBurst(highMid, 22, true);
          this.sparkLight.position.copy(highMid);
          this.sparkLight.color.setHex(0xfbbf24);
          this.sparkLight.intensity = 4.0;
          if (this.onTrauma) this.onTrauma(0.42, false);
        }
        const p = Math.sin(((u - 0.74) / 0.26) * Math.PI);
        for (const c of [charA, charB]) {
          applyAnticipationWeightShift(c, 0, -0.010 * p, 0, 0.012 * p);
          c.J.spine.rotation.set(-0.15 * p, 0, 0);
          c.J.shoulderR.rotation.set(-2.10 * p, 0.15, -0.32 * p);
          c.J.shoulderL.rotation.set(-2.10 * p, -0.15, 0.32 * p);
          setFingerCascade(c.J, 'R', 1.0 - p, 0.08, 0.88, 0.65);
          setFingerCascade(c.J, 'L', 1.0 - p, 0.08, 0.88, 0.65);
          setEyesAndBrows(c.J, 1.45, 1.0);
        }
      }
    } else if (typeId === 3) {
      // 3. FAKE-OUT HARDHAT PSYCH!
      const bReach = Math.min(1, u / 0.22);
      const bArc = -0.028 * Math.sin(bReach * Math.PI);
      tgtB.set(s.mid.x - rx * (0.10 * (1 - bReach) + 0.02), midY + bArc, s.mid.z - rz * (0.10 * (1 - bReach) + 0.02));
      solveArmIKWorld(charB, 'R', tgtB, 0.12, u > 0.52 ? 0.24 : -0.10, u > 0.52 ? 0.28 : 0.0);
      setFingerCascade(charB.J, 'R', u > 0.55 ? (u - 0.55) * 0.8 : 0.05, 0.10, 0.55, 0.35);
      setEyesAndBrows(charB.J, u < 0.48 ? 1.35 : 0.32, u < 0.48 ? 0.8 : 'sad');

      if (u < 0.44) {
        const p = Math.min(1, u / 0.34);
        const sep = 0.18 - 0.11 * p;
        const arcA = -0.032 * Math.sin(p * Math.PI);
        tgtA.set(s.mid.x + rx * sep, midY + arcA, s.mid.z + rz * sep);
        solveArmIKWorld(charA, 'R', tgtA, 0.15 * p, -0.16 * p, -0.12 * p);
        setFingerCascade(charA.J, 'R', 0.08, 0.08, 0.65, 0.30);
        setEyesAndBrows(charA.J, 1.15, 0.65);
      } else {
        // PSYCH! Coils back & yanks right hand along C-arc straight up to own hardhat brim!
        const p = Math.sin(Math.min(1, (u - 0.44) / 0.45) * Math.PI);
        applyAnticipationWeightShift(charA, 0.014 * p, -0.024 * p, 0.18 * p, 0.008 * p);
        charA.J.shoulderR.rotation.set(-2.15 * p, 0.25, -0.32 * p);
        charA.J.elbowR.rotation.set(-1.68 * p, 0, 0);
        if (charA.J.forearmTwistR) charA.J.forearmTwistR.rotation.set(0, -0.42 * p, 0);
        charA.J.wristR.rotation.set(0.22 * p, -0.30 * p, 0.24 * p);
        charA.J.head.rotation.set(0.08 * p, -0.22 * p, 0);
        setFingerCascade(charA.J, 'R', p * 0.65, 0.10, 0.68, 0.55);
        setEyesAndBrows(charA.J, 0.68, 0.95);
      }
    } else if (typeId === 4) {
      // 4. CARL'S PAPER-COVERS-ROCK AWKWARD FAIL!
      const p = Math.min(1, u / 0.28);
      const arcDip = -0.030 * Math.sin(p * Math.PI);
      const rockRecoil = impactOvershootRecoil(u - 0.28);
      // Partner B offers supinated open cupped palm; Initiator A panics and jams pronated clenched rock fist into it!
      tgtB.set(
        s.mid.x - rx * (0.10 - 0.082 * p - rockRecoil * 0.7),
        midY + arcDip * 0.5,
        s.mid.z - rz * (0.10 - 0.082 * p - rockRecoil * 0.7)
      );
      tgtA.set(
        s.mid.x + rx * (0.12 - 0.102 * p + rockRecoil),
        midY + arcDip,
        s.mid.z + rz * (0.12 - 0.102 * p + rockRecoil)
      );
      solveArmIKWorld(charB, 'R', tgtB, -1.25 * p, -0.18 * p, 0.10 * p);
      solveArmIKWorld(charA, 'R', tgtA, 1.48 * p, 0.12 * p, 0.22 * p);
      setFingerCascade(charA.J, 'R', u / 0.18, 0.14, 0.96, 0.95);
      setFingerCascade(charB.J, 'R', u > 0.32 ? (u - 0.32) / 0.22 : 0.0, 0.08, 0.42, 0.52);
      setEyesAndBrows(charA.J, 1.55, 1.0);
      setEyesAndBrows(charB.J, 0.65, -0.85);
      if (u > 0.35) {
        const w = 0.025 * Math.sin(u * Math.PI * 6);
        charA.J.head.rotation.set(0.10, w * 4, 0);
      }
    } else {
      // 5. TINY GIANT-FINGERTIP SHAKE!
      const reach = Math.min(1, u / 0.22);
      const bob = u > 0.22 ? 0.024 * Math.sin(((u - 0.22) / 0.78) * Math.PI * 4) : -0.022 * Math.sin(reach * Math.PI);
      const pinchY = Math.min(charA.J._scale, charB.J._scale) * 0.35 + bob;
      const giant = charA.J._scale >= charB.J._scale ? charA : charB;
      const regular = giant === charA ? charB : charA;

      const gSgn = giant === charA ? -1 : 1;
      const pinchSep = 0.038 + impactOvershootRecoil(u - 0.22) * 0.5;
      applyAnticipationWeightShift(giant, 0, 0.018 * reach, 0, 0.022 * reach);
      tgtA.set(s.mid.x + gSgn * nx * pinchSep, pinchY + 0.028, s.mid.z + gSgn * nz * pinchSep);
      tgtB.set(s.mid.x - gSgn * nx * pinchSep, pinchY, s.mid.z - gSgn * nz * pinchSep);
      solveArmIKWorld(giant, 'R', tgtA, 0.42, 0.24, 0.18 * Math.sin(u * Math.PI * 4));
      solveArmIKWorld(regular, 'R', tgtB, -0.18, -0.14, 0.14 * Math.sin(u * Math.PI * 4));
      // Delicate index+thumb precision pinch with pinky+ring curled cleanly into metacarpal arch!
      setFingerCurl(giant.J, 'R', 0.46, 0.90, 0.96, 0.78, 0.94, 0.88);
      setFingerCascade(regular.J, 'R', reach * 0.6, 0.12, 0.48, 0.45);
      giant.J.head.rotation.set(0.24, 0.08 * Math.sin(u * Math.PI * 4), 0);
      regular.J.head.rotation.set(-0.24, 0, 0);
      setEyesAndBrows(giant.J, 0.95, 0.55);
      setEyesAndBrows(regular.J, 1.35, 0.85);
    }
  }
}
