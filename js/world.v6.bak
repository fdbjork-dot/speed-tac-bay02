  _buildOshaAndGreenMileHose() {
    // OSHA Safety Directive 404-B ("DAYS WITHOUT A CARL INCIDENT: 00")
    this._addFramedSign({
      texFile: 'osha_safety_board.png',
      w: 2.10,
      h: 1.50,
      x: 4.40,
      y: 1.38,
      z: 10.15,
      ry: 0.38,
